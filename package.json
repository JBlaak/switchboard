{
  "name": "switchboard",
  "version": "0.0.33",
  "private": true,
  "description": "A desktop app for browsing, searching, and managing CLI coding sessions",
  "author": "Doctly <support@doctly.ai>",
  "main": "app/main.js",
  "engines": {
    "node": ">=18.20"
  },
  "scripts": {
    "start": "npm run build && electron .",
    "dev": "node scripts/build.mjs --watch & electron .",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "tsx --test test/*.test.ts",
    "electron": "electron .",
    "electron-dev": "SWITCHBOARD_DATA_DIR=\"$HOME/.switchboard-dev\" electron .",
    "generate-icons": "node scripts/generate-icons.js && node scripts/generate-dmg-background.js",
    "dist": "npm run build && electron-builder",
    "build:mac": "npm run build && electron-builder --mac && node scripts/postinstall.js",
    "build:mac:arm64": "npm run build && electron-builder --mac --arm64 && node scripts/postinstall.js",
    "build:win": "npm run build && electron-builder --win",
    "build:linux": "npm run build && electron-builder --linux",
    "release": "npm run build && electron-builder --publish always",
    "postinstall": "node scripts/postinstall.js"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode-graphemes": "^0.4.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^12.0.0",
    "electron-log": "^5.3.0",
    "electron-updater": "^6.8.9",
    "marked": "^17.0.4",
    "morphdom": "^2.7.8",
    "node-pty": "^1.0.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.10.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/merge": "^6.12.1",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.39.16",
    "@ddietr/codemirror-themes": "^1.5.2",
    "@napi-rs/canvas": "^0.1.62",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.5.0",
    "@types/ws": "^8.18.1",
    "codemirror": "^6.0.2",
    "electron": "^41.0.0",
    "electron-builder": "^26.0.0",
    "electron-reloader": "^1.2.3",
    "esbuild": "^0.27.3",
    "png2icons": "^2.0.1",
    "sass": "^1.104.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "ai.doctly.switchboard",
    "productName": "Switchboard",
    "files": [
      "app/**/*",
      "build/icon.png",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "node_modules/node-pty/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "doctly",
      "repo": "switchboard"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "pacman"
      ],
      "icon": "build/icons",
      "category": "Development"
    },
    "pacman": {
      "packageName": "switchboard-doctly",
      "artifactName": "switchboard-doctly-${version}.${ext}",
      "depends": [
        "gtk3",
        "nss",
        "libnotify",
        "libxtst",
        "libxss",
        "xdg-utils",
        "libsecret"
      ]
    },
    "dmg": {
      "background": "build/dmg-background.png",
      "iconSize": 100,
      "window": {
        "width": 660,
        "height": 400
      },
      "contents": [
        {
          "x": 170,
          "y": 170
        },
        {
          "x": 490,
          "y": 170,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
