<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing leaves the phone in a cloud backup or a device-to-device transfer: the pairing only means
    something with this phone's Keystore key, which never travels, and allowBackup="false" alone does not
    stop a transfer to a new phone on Android 12 and later.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
